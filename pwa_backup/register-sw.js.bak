// Регистрация Service Worker
if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js')
            .then(reg => console.log('SW registered:', reg))
            .catch(err => console.log('SW registration failed:', err));
    });
}

let deferredPrompt;
let installButton = null;

// Функция для получения кнопки (обновляет глобальную переменную)
function getInstallButton() {
    if (!installButton || !document.body.contains(installButton)) {
        installButton = document.getElementById('installPwaBtn');
    }
    return installButton;
}

function showInstallButton() {
    const btn = getInstallButton();
    if (btn) {
        btn.style.display = 'inline-block';
        btn.onclick = async () => {
            if (deferredPrompt) {
                deferredPrompt.prompt();
                const { outcome } = await deferredPrompt.userChoice;
                if (outcome === 'accepted') {
                    console.log('Пользователь установил PWA');
                } else {
                    console.log('Пользователь отклонил установку');
                }
                deferredPrompt = null;
                btn.style.display = 'none';
            } else {
                showManualInstallHelp();
            }
        };
    }
}

function showManualInstallHelp() {
    const ua = navigator.userAgent.toLowerCase();
    let message = '';
    if (ua.includes('chrome') || ua.includes('edg')) {
        message = 'Для установки приложения: нажмите на значок "⋮" в правом верхнем углу браузера → "Установить приложение" или "Установить IronMarket".';
    } else if (ua.includes('safari') && !ua.includes('chrome') && !ua.includes('edg')) {
        message = 'Для установки на iOS: нажмите "Поделиться" (квадрат со стрелкой) → "На экран "Домой"".';
    } else if (ua.includes('firefox')) {
        message = 'Firefox на компьютере не поддерживает установку PWA. Пожалуйста, используйте Chrome, Edge или Safari.';
    } else {
        message = 'Ваш браузер не поддерживает автоматическую установку. Используйте Chrome, Edge или Safari на iOS.';
    }
    alert(message);
}

window.addEventListener('beforeinstallprompt', (e) => {
    console.log('beforeinstallprompt fired');
    e.preventDefault();
    deferredPrompt = e;
    showInstallButton();
});

// Если beforeinstallprompt не сработал через 5 секунд, показываем кнопку с инструкцией
setTimeout(() => {
    const btn = getInstallButton();
    if (!deferredPrompt && btn && btn.style.display !== 'inline-block') {
        btn.style.display = 'inline-block';
        btn.onclick = () => {
            showManualInstallHelp();
        };
    }
}, 5000);

window.addEventListener('appinstalled', () => {
    console.log('PWA установлено');
    const btn = getInstallButton();
    if (btn) btn.style.display = 'none';
});

// Дополнительная страховка: после загрузки DOM показываем кнопку, если она ещё не видна
document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
        const btn = getInstallButton();
        if (!deferredPrompt && btn && btn.style.display !== 'inline-block') {
            btn.style.display = 'inline-block';
            btn.onclick = () => {
                showManualInstallHelp();
            };
        }
    }, 1000);
});